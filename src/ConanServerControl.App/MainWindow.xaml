<Window x:Class="ConanServerControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conan Server Control"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="980"
        Background="{StaticResource BgBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="12,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="CONAN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="Server Control" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
          <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Margin="0,0,0,16" Foreground="{StaticResource WarningBrush}" />
        </StackPanel>
        <StackPanel>
          <Button Style="{StaticResource NavButton}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
          <Button Style="{StaticResource NavButton}" Content="Server" Command="{Binding NavigateCommand}" CommandParameter="Server" />
          <Button Style="{StaticResource NavButton}" Content="Mods" Command="{Binding NavigateCommand}" CommandParameter="Mods" />
          <Button Style="{StaticResource NavButton}" Content="Players" Command="{Binding NavigateCommand}" CommandParameter="Players" />
          <Button Style="{StaticResource NavButton}" Content="Backups" Command="{Binding NavigateCommand}" CommandParameter="Backups" />
          <Button Style="{StaticResource NavButton}" Content="Updates" Command="{Binding NavigateCommand}" CommandParameter="Updates" />
          <Button Style="{StaticResource NavButton}" Content="Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs" />
          <Button Style="{StaticResource NavButton}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
          <Button Style="{StaticResource NavButton}" Content="Diagnostics" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" Margin="24">
      <TextBlock DockPanel.Dock="Top" Text="{Binding Banner}" TextWrapping="Wrap"
                 Foreground="{StaticResource WarningBrush}" Margin="0,0,0,16" />
      <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
  </Grid>
</Window>
