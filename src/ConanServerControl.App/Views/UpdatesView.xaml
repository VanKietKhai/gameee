<UserControl x:Class="ConanServerControl.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Updates" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Margin="0,12" Text="{Binding Summary}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Countdown}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
    <WrapPanel Margin="0,16,0,0">
      <Button Style="{StaticResource GhostButton}" Content="CHECK UPDATES" Command="{Binding CheckCommand}" />
      <Button Style="{StaticResource PrimaryButton}" Content="UPDATE SERVER" Command="{Binding UpdateCommand}" />
      <Button Style="{StaticResource GhostButton}" Content="RESTART IN 10 MINUTES" Command="{Binding Delay10Command}" />
      <Button Style="{StaticResource DangerButton}" Content="CANCEL COUNTDOWN" Command="{Binding CancelCommand}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
