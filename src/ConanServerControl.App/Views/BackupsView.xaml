<UserControl x:Class="ConanServerControl.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Backups" FontSize="24" FontWeight="SemiBold" />
      <WrapPanel Margin="0,12">
        <Button Style="{StaticResource PrimaryButton}" Content="BACKUP NOW" Command="{Binding BackupCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
      </WrapPanel>
      <TextBlock Text="Restore backup id (folder name). Server must be offline." Margin="0,0,0,4" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="RESTORE" Command="{Binding RestoreCommand}" />
        <TextBox Text="{Binding BackupId}" />
      </DockPanel>
    </StackPanel>
    <TextBox Margin="0,12,0,0" Text="{Binding Listing}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</UserControl>
