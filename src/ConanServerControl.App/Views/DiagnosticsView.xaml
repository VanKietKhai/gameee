<UserControl x:Class="ConanServerControl.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Status badge: colour by DiagnosticStatus. PASS is paired with an evidence label so it never implies a live test. -->
    <Style x:Key="StatusBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="#FF2D3340" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Pass">
          <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warning">
          <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Fail">
          <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusBadgeText" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Pass">
          <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warning">
          <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Fail">
          <Setter Property="Foreground" Value="White" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadinessCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsReady}" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ReadinessTemplate">
      <Border Style="{StaticResource ReadinessCard}">
        <StackPanel>
          <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Blockers}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat=Blocker: {0}}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Diagnostics" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Read-only integration checks. Nothing is started, installed, downloaded or modified."
                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
      <WrapPanel>
        <Button Style="{StaticResource PrimaryButton}" Content="RUN INTEGRATION CHECK" Command="{Binding RunCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="Export report" Command="{Binding ExportCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="Open report folder" Command="{Binding OpenReportFolderCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="Install SteamCMD" Command="{Binding InstallSteamCmdCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding LastRunText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      <TextBlock Text="Running checks..." Foreground="{StaticResource WarningBrush}"
                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,8,0,4">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Left">
                            <Border Style="{StaticResource StatusBadge}">
                              <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusBadgeText}" />
                            </Border>
                            <TextBlock Text="{Binding EvidenceLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,8,0" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding SuggestedAction, StringFormat=Suggested: {0}}" TextWrapping="Wrap"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding HasSuggestedAction, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Live test readiness (M3 Task 4)" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4" />
        <TextBlock Text="Readiness is based on configuration checks only. Nothing above has been live verified."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ContentControl Content="{Binding ServerReadiness}" ContentTemplate="{StaticResource ReadinessTemplate}" />
        <ContentControl Content="{Binding ClientReadiness}" ContentTemplate="{StaticResource ReadinessTemplate}" />

        <Expander Header="Environment" Foreground="{StaticResource TextBrush}" Margin="0,8,0,16">
          <TextBox Text="{Binding EnvironmentSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                   AcceptsReturn="True" FontFamily="Consolas" Margin="0,8,0,0" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
