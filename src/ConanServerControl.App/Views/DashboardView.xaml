<UserControl x:Class="ConanServerControl.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="SERVER" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="Bold" Margin="0,6,0,8" />
            <TextBlock Text="{Binding ServerName}" />
            <TextBlock Text="{Binding ServerIp}" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                       Text="{Binding GamePort, StringFormat=Game {0}}" />
            <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding QueryPort, StringFormat=Query {0}}" />
            <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding RconPort, StringFormat=RCON {0}}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding Uptime, StringFormat=Uptime {0}}" />
            <TextBlock Text="{Binding Cpu, StringFormat=CPU {0}}" />
            <TextBlock Text="{Binding Ram, StringFormat=RAM {0}}" />
            <TextBlock Text="{Binding Version, StringFormat=Build {0}}" />
            <TextBlock Text="{Binding LatestBuild}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="PLAYERS" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding PlayerSummary}" FontSize="22" FontWeight="Bold" Margin="0,6,0,8" />
            <TextBlock Text="{Binding PlayersList}" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0" Text="MODS" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding ModsSummary}" FontWeight="SemiBold" />
            <TextBlock Margin="0,16,0,0" Text="UPDATES" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding PipelineText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="BACKUPS / REMOTE" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding LastBackup, StringFormat=Last backup: {0}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LastUpdateCheck, StringFormat=Last check: {0}}" TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <WrapPanel>
        <Button Style="{StaticResource PrimaryButton}" Content="START SERVER" Command="{Binding StartCommand}" />
        <Button Style="{StaticResource DangerButton}" Content="STOP SERVER" Command="{Binding StopCommand}" />
        <Button Style="{StaticResource PrimaryButton}" Content="RESTART SERVER" Command="{Binding RestartCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="DELAYED RESTART" Command="{Binding DelayedRestartCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="CHECK UPDATES" Command="{Binding CheckUpdatesCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="UPDATE SERVER" Command="{Binding UpdateServerCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="UPDATE MODS" Command="{Binding UpdateModsCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="UPDATE EVERYTHING &amp; RESTART" Command="{Binding UpdateEverythingCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="BACKUP NOW" Command="{Binding BackupNowCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="OPEN SERVER FOLDER" Command="{Binding OpenServerFolderCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="OPEN LOGS" Command="{Binding OpenLogsCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="WEB ADMIN" Command="{Binding OpenWebAdminCommand}" />
      </WrapPanel>

      <TextBlock Text="ACTIVITY" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,8" />
      <ItemsControl ItemsSource="{Binding Activity}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Margin="0,2" Foreground="{StaticResource MutedBrush}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
