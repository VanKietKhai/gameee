<UserControl x:Class="ConanServerControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Cài đặt" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

      <TextBlock Text="SERVER" Foreground="{StaticResource MutedBrush}" />
      <CheckBox Content="Tự bật server khi mở app" IsChecked="{Binding StartServerOnLaunch}" />
      <CheckBox Content="Tự khởi động lại server khi bị crash" IsChecked="{Binding RestartAfterCrash}" Margin="0,8,0,16" />

      <TextBlock Text="DISCORD" Foreground="{StaticResource MutedBrush}" />
      <CheckBox Content="Gửi thông báo trạng thái server lên Discord" IsChecked="{Binding DiscordEnabled}" />
      <CheckBox Content="Báo người chơi vào / thoát / mất kết nối" IsChecked="{Binding NotifyPlayerEvents}" />
      <CheckBox Content="Báo bản cập nhật server / mod / game" IsChecked="{Binding NotifyUpdates}" />
      <TextBlock Text="Webhook URL mới (chỉ ghi, lưu mã hoá, không hiện lại)" Margin="0,12,0,4" />
      <PasswordBox x:Name="DiscordWebhookBox" Margin="0,0,0,4" PasswordChanged="DiscordWebhookBox_OnPasswordChanged" />
      <TextBlock Text="{Binding DiscordWebhookStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
      <Button Style="{StaticResource GhostButton}" Content="GỬI THỬ DISCORD" Command="{Binding TestDiscordCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />

      <TextBlock Text="CẬP NHẬT (STEAM)" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="Tần suất kiểm tra" Margin="0,8,0,4" />
      <ComboBox ItemsSource="{Binding UpdateCheckIntervals}" SelectedItem="{Binding UpdateCheckInterval}" HorizontalAlignment="Left" MinWidth="160" />
      <TextBlock Text="Khi có bản mới: Manual = chỉ báo; Automatic = tự sao lưu rồi cập nhật khi server trống; Scheduled = tự cập nhật trong khung giờ bảo trì. Game client luôn do Steam cập nhật." TextWrapping="Wrap" Margin="0,12,0,4" />
      <ComboBox ItemsSource="{Binding AutomationModes}" SelectedItem="{Binding UpdateAutomationMode}" HorizontalAlignment="Left" MinWidth="160" />
      <CheckBox Content="Bật Cloudflare WARP khi SteamCMD tải (tự tắt khi tải xong)" IsChecked="{Binding UseCloudflareWarp}" Margin="0,8,0,16" />

      <Button Style="{StaticResource PrimaryButton}" Content="LƯU CÀI ĐẶT" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
