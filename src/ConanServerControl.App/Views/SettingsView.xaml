<UserControl x:Class="ConanServerControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
      <TextBlock Text="Server paths" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="Use an existing Conan Dedicated Server installation (SteamCMD is optional). Never the game client." TextWrapping="Wrap" Margin="0,4,0,4" />
      <Button Style="{StaticResource GhostButton}" Content="Use existing server installation" Command="{Binding UseExistingServerCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
      <TextBlock Text="Conan server executable" Margin="0,8,0,4" />
      <DockPanel LastChildFill="True" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse" Command="{Binding BrowseExecutableCommand}" />
        <TextBox Text="{Binding ServerExecutablePath}" />
      </DockPanel>
      <TextBlock Text="Working directory" Margin="0,8,0,4" />
      <DockPanel LastChildFill="True" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse" Command="{Binding BrowseWorkingDirectoryCommand}" />
        <TextBox Text="{Binding ServerWorkingDirectory}" />
      </DockPanel>
      <TextBlock Text="Install directory (SteamCMD app 443030)" Margin="0,8,0,4" />
      <DockPanel LastChildFill="True" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse" Command="{Binding BrowseInstallDirectoryCommand}" />
        <TextBox Text="{Binding ServerInstallDirectory}" />
      </DockPanel>
      <TextBlock Text="Launch arguments" Margin="0,8,0,4" />
      <TextBox Text="{Binding AdditionalArguments}" Margin="0,0,0,12" />

      <TextBlock Text="SteamCMD folder" Foreground="{StaticResource MutedBrush}" />
      <DockPanel LastChildFill="True" Margin="0,8,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse" Command="{Binding BrowseSteamCmdCommand}" />
        <TextBox Text="{Binding SteamCmdDirectory}" />
      </DockPanel>

      <TextBlock Text="Standalone Conan client (optional, game client only)" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="Folder that contains the client ConanSandbox.exe. Used only by read-only Diagnostics. Never used as the dedicated server, never launched, and Workshop mods are not synchronized to it automatically."
                 TextWrapping="Wrap" Margin="0,4,0,4" />
      <DockPanel LastChildFill="True" Margin="0,4,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse" Command="{Binding BrowseStandaloneClientCommand}" />
        <TextBox Text="{Binding StandaloneClientRoot}" />
      </DockPanel>

      <TextBlock Text="Server identity" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="Server name" Margin="0,8,0,4" />
      <TextBox Text="{Binding ServerName}" />
      <TextBlock Text="Max players" Margin="0,8,0,4" />
      <TextBox Text="{Binding MaxPlayers}" />
      <TextBlock Text="Game / Query / RCON ports" Margin="0,8,0,4" />
      <UniformGrid Columns="3" Margin="0,0,0,12">
        <TextBox Text="{Binding GamePort}" Margin="0,0,8,0" />
        <TextBox Text="{Binding QueryPort}" Margin="0,0,8,0" />
        <TextBox Text="{Binding RconPort}" />
      </UniformGrid>
      <TextBlock Text="RCON password (write-only, stored with Windows DPAPI, never shown again)" Margin="0,8,0,4" />
      <PasswordBox x:Name="RconPasswordBox" Margin="0,0,0,4" PasswordChanged="RconPasswordBox_OnPasswordChanged" />
      <TextBlock Text="{Binding RconPasswordStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
      <Button Style="{StaticResource GhostButton}" Content="Clear RCON password" Command="{Binding ClearRconPasswordCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

      <TextBlock Text="Web Admin (localhost by default, no router ports opened)" Foreground="{StaticResource MutedBrush}" />
      <CheckBox Content="Enable Web Admin" IsChecked="{Binding WebAdminEnabled}" />
      <TextBlock Text="Port" Margin="0,8,0,4" />
      <TextBox Text="{Binding WebAdminPort}" />
      <TextBlock Text="Username" Margin="0,8,0,4" />
      <TextBox Text="{Binding WebAdminUsername}" />
      <TextBlock Text="New password (stored as PBKDF2 hash, never plaintext)" Margin="0,8,0,4" />
      <TextBox Text="{Binding WebAdminPassword}" />
      <TextBlock Text="Bind mode: LocalhostOnly, LAN, or Custom" Margin="0,8,0,4" />
      <TextBox Text="{Binding BindMode}" Margin="0,0,0,12" />

      <TextBlock Text="Discord" Foreground="{StaticResource MutedBrush}" />
      <CheckBox Content="Gửi thông báo trạng thái server lên Discord" IsChecked="{Binding DiscordEnabled}" Margin="0,4,0,0" />
      <CheckBox Content="Báo người chơi vào / thoát / mất kết nối" IsChecked="{Binding NotifyPlayerEvents}" />
      <CheckBox Content="Báo bản cập nhật server / mod / game" IsChecked="{Binding NotifyUpdates}" />
      <TextBlock Text="Webhook URL (chỉ ghi, lưu mã hoá bằng Windows DPAPI, không hiện lại)" Margin="0,8,0,4" />
      <PasswordBox x:Name="DiscordWebhookBox" Margin="0,0,0,4" PasswordChanged="DiscordWebhookBox_OnPasswordChanged" />
      <TextBlock Text="{Binding DiscordWebhookStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
      <Button Style="{StaticResource GhostButton}" Content="Gửi thử Discord" Command="{Binding TestDiscordCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

      <TextBlock Text="Kiểm tra cập nhật (Steam)" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="Tần suất kiểm tra" Margin="0,8,0,4" />
      <ComboBox ItemsSource="{Binding UpdateCheckIntervals}" SelectedItem="{Binding UpdateCheckInterval}" HorizontalAlignment="Left" MinWidth="160" />
      <TextBlock Text="Khi có bản mới: Manual = chỉ báo; Automatic = tự sao lưu rồi cập nhật khi server trống; Scheduled = tự cập nhật trong khung giờ bảo trì. Game client luôn do Steam cập nhật." TextWrapping="Wrap" Margin="0,8,0,4" />
      <ComboBox ItemsSource="{Binding AutomationModes}" SelectedItem="{Binding UpdateAutomationMode}" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,8" />
      <CheckBox Content="Bật Cloudflare WARP khi SteamCMD tải (tự tắt khi tải xong)" IsChecked="{Binding UseCloudflareWarp}" Margin="0,0,0,12" />

      <CheckBox Content="Start Conan server when the manager launches" IsChecked="{Binding StartServerOnLaunch}" />
      <CheckBox Content="Restart server after crash" IsChecked="{Binding RestartAfterCrash}" />

      <WrapPanel Margin="0,16,0,0">
        <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}" />
        <Button Style="{StaticResource GhostButton}" Content="Detect installs" Command="{Binding DetectCommand}" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
